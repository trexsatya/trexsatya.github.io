td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>&nbsp;</p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Uttryck</th>\n\t\t\t<th>&Ouml;vers&auml;ttning</th>\n\t\t\t<th>Syftar p&aring;</th>\n\t\t\t<th>Exempel</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>Lo que</strong></td>\n\t\t\t<td>Det som / Vad</td>\n\t\t\t<td>N&aring;got obest&auml;mt eller en id&eacute;</td>\n\t\t\t<td><em>Lo que dijiste fue raro. &lt;</em>Det du sa var konstigt.<em>&gt;</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>El que / la que / etc.</strong></td>\n\t\t\t<td>Den som / De som</td>\n\t\t\t<td>En specifik person eller sak</td>\n\t\t\t<td><em>El que canta es Pedro. &lt;</em>Den som sjunger &auml;r Pedro.<em>&gt;</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Lo cual</strong></td>\n\t\t\t<td>Vilket</td>\n\t\t\t<td>En tidigare n&auml;mnd sats</td>\n\t\t\t<td><em>Se cay&oacute;, lo cual fue gracioso. &lt;</em>Han/hon ramlade, vilket var roligt.<em>&gt;</em></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>Pronunciaci&oacute;n</p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Bokstav/ljud</th>\n\t\t\t<th>Standarduttal</th>\n\t\t\t<th>Vardagligt uttal</th>\n\t\t\t<th>Exempel</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>d</strong> (mellan vokaler, s&auml;rskilt -ado, -ido)</td>\n\t\t\t<td>[&eth;] (som eng. &quot;th&quot; i <em>this</em>)</td>\n\t\t\t<td>f&ouml;rsvinner ofta</td>\n\t\t\t<td><em>cansado &rarr; cansao</em>, <em>pescado &rarr; pescao</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>s</strong> (slut p&aring; ord, f&ouml;re konsonant)</td>\n\t\t\t<td>[s]</td>\n\t\t\t<td>[h] eller faller bort</td>\n\t\t\t<td><em>los amigos &rarr; lo[h] amigo</em>, <em>estas &rarr; et&aacute;</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>r</strong> (slut p&aring; ord)</td>\n\t\t\t<td>[\u027e]</td>\n\t\t\t<td>faller ofta bort</td>\n\t\t\t<td><em>comer &rarr; com&eacute;</em>, <em>amor &rarr; am&oacute;</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>r/l</strong> (i vissa dialekter, Karibien, Andalusien)</td>\n\t\t\t<td>[\u027e]/[l]</td>\n\t\t\t<td>byts mot varandra (<em>rotacismo</em> / <em>lambdacismo</em>)</td>\n\t\t\t<td><em>mar &rarr; mal</em>, <em>algo &rarr; argo</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>g/b</strong> (mellan vokaler)</td>\n\t\t\t<td>[\u0263]/[&beta;] (mjuk g/b)</td>\n\t\t\t<td>mycket svagt, n&auml;stan borta</td>\n\t\t\t<td><em>lago &rarr; [lao]</em>, <em>sabe &rarr; [sa&beta;e]</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>j/g (e,i)</strong></td>\n\t\t\t<td>[&chi;] (i Spanien), [h] (i Latinamerika)</td>\n\t\t\t<td>ibland mycket svagt eller faller</td>\n\t\t\t<td><em>trabajo &rarr; trabao</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>z, c (e, i)</strong></td>\n\t\t\t<td>[&theta;] (Spanien), [s] (Latinamerika)</td>\n\t\t\t<td>seseo (alltid [s])</td>\n\t\t\t<td><em>zapato &rarr; sapato</em>, <em>cena &rarr; sena</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>e</strong> (i b&ouml;rjan av ord, s&auml;rskilt <em>estar</em>)</td>\n\t\t\t<td>[e]</td>\n\t\t\t<td>kan falla bort</td>\n\t\t\t<td><em>est&aacute; &rarr; &rsquo;t&aacute;</em>, <em>estamos &rarr; &rsquo;tamos</em></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p>---------------</p>\n\n<p><u><strong>Hablas&nbsp;espa&ntilde;ol?</strong></u></p>\n\n<p>No hablo espa&ntilde;ol,<br />\nNo s&eacute;&nbsp;espa&ntilde;ol,<br />\nNo entiendo&nbsp;espa&ntilde;ol<br />\nNo puedo hablar&nbsp;espa&ntilde;ol</p>\n\n<p>Quieres,&nbsp;Quieres,&nbsp;Quieres aprender&nbsp;espa&ntilde;ol?<br />\nSi, quiero.&nbsp;Si, quiero.&nbsp;Si, quiero&nbsp;aprender&nbsp;espa&ntilde;ol.<br />\nQuier&eacute;is,&nbsp;Quier&eacute;is,&nbsp;Quier&eacute;is&nbsp;aprender&nbsp;espa&ntilde;ol?<br />\nSi&nbsp;queremos, Si&nbsp;queremos,&nbsp;aprender&nbsp;espa&ntilde;ol!</p>\n\n<p>Quiero&nbsp;aprender la m&uacute;sica y el idioma&nbsp;espa&ntilde;ol!</p>\n\n<p>Para aprender algo nuevo,<br />\nes importante ser dedicado,<br />\ny tener un plan.<br />\nEs bueno empezar con lo m&aacute;s com&uacute;n,<br />\nEs bueno comienzar con lo m&aacute;s com&uacute;n,<br />\nCon algo f&aacute;cil, con los verbos comunes.</p>\n\n<p>Es bueno empezar con lo b&aacute;sico,<br />\nEs bueno comienzar con algo sencillo.</p>\n\n<p>Escribe, lee y escucha,<br />\nEscribe, lee y habla,<br />\nEscribe conciones, escribe historias,<br />\nHas listas, encuentra relationes,<br />\nUsa trucos,&nbsp;encuentra diferencias,<br />\nLee&nbsp;chistes, lee poemas y historias.</p>\n\n<p>Juega&nbsp;Juega&nbsp;Juega con el cuerpo,<br />\nJuega&nbsp;Juega&nbsp;Juega con el lenguaje,<br />\nJuega con las palabras<br />\nJuega con las frases.</p>\n\n<p>Usa im&aacute;genes, v&iacute;deos, canciones&nbsp;<br />\nUsa poemas o&nbsp;chistes<br />\nUsa&nbsp;todo posible lo que sea</p>\n\n<p>Has preguntas para aprender espa&ntilde;ol<br />\nComo se dice en&nbsp;espa&ntilde;ol?<br />\nQui&eacute;n hace qu&eacute; y cu&aacute;ndo y por qu&eacute;?<br />\nQu&eacute; pasa y cu&aacute;ndo y por qu&eacute;?<br />\nC&oacute;mo se hace y por que?<br />\nQu&eacute; necesitamos y por qu&eacute;?</p>\n\n<p>Est&aacute; bien equivocarse<br />\nEst&aacute; bien cometer errores<br />\nVas a cometer errores<br />\nPero, Pero sigue adelante</p>\n\n<p>Quiero,&nbsp;Quiero,&nbsp;Quiero aprender espa&ntilde;ol<br />\nAhora s&eacute; un poco de espa&ntilde;ol<br />\nFinalmente s&eacute; un poco de espa&ntilde;ol<br />\nEsto es solo el comienzo<br />\nPronto podr&eacute; hablar mejor espa&ntilde;ol!</p>\n\n<p>---------------</p>\n\n<p><u><strong>Patrones verbales</strong></u></p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Person</th>\n\t\t\t<th>Presens (-ar: <em>hablar</em>)</th>\n\t\t\t<th>Presens (-er: <em>comer</em>)</th>\n\t\t\t<th>Presens (-ir: <em>vivir</em>)</th>\n\t\t\t<th>Preteritum (-ar)</th>\n\t\t\t<th>Preteritum (-er)</th>\n\t\t\t<th>Preteritum (-ir)</th>\n\t\t\t<th>Futurum (alla)</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>yo</td>\n\t\t\t<td>hablo</td>\n\t\t\t<td>como</td>\n\t\t\t<td>vivo</td>\n\t\t\t<td>habl&eacute;</td>\n\t\t\t<td>com&iacute;</td>\n\t\t\t<td>viv&iacute;</td>\n\t\t\t<td>hablar&eacute; / comer&eacute; / vivir&eacute;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>t&uacute;</td>\n\t\t\t<td>hablas</td>\n\t\t\t<td>comes</td>\n\t\t\t<td>vives</td>\n\t\t\t<td>hablaste</td>\n\t\t\t<td>comiste</td>\n\t\t\t<td>viviste</td>\n\t\t\t<td>hablar&aacute;s / comer&aacute;s / vivir&aacute;s</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>&eacute;l/ella</td>\n\t\t\t<td>habla</td>\n\t\t\t<td>come</td>\n\t\t\t<td>vive</td>\n\t\t\t<td>habl&oacute;</td>\n\t\t\t<td>comi&oacute;</td>\n\t\t\t<td>vivi&oacute;</td>\n\t\t\t<td>hablar&aacute; / comer&aacute; / vivir&aacute;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>nosotros</td>\n\t\t\t<td>hablamos</td>\n\t\t\t<td>comemos</td>\n\t\t\t<td>vivimos</td>\n\t\t\t<td>hablamos</td>\n\t\t\t<td>comimos</td>\n\t\t\t<td>vivimos</td>\n\t\t\t<td>hablaremos / comeremos / viviremos</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>vosotros</td>\n\t\t\t<td>habl&aacute;is</td>\n\t\t\t<td>com&eacute;is</td>\n\t\t\t<td>viv&iacute;s</td>\n\t\t\t<td>hablasteis</td>\n\t\t\t<td>comisteis</td>\n\t\t\t<td>vivisteis</td>\n\t\t\t<td>hablar&eacute;is / comer&eacute;is / vivir&eacute;is</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>ellos</td>\n\t\t\t<td>hablan</td>\n\t\t\t<td>comen</td>\n\t\t\t<td>viven</td>\n\t\t\t<td>hablaron</td>\n\t\t\t<td>comieron</td>\n\t\t\t<td>vivieron</td>\n\t\t\t<td>hablar&aacute;n / comer&aacute;n / vivir&aacute;n</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p data-end=\"2905\" data-start=\"2870\"><strong data-end=\"2905\" data-start=\"2873\">M&ouml;nster att l&auml;gga p&aring; minnet:</strong></p>\n\n<ul data-end=\"3280\" data-start=\"2906\">\n\t<li data-end=\"3058\" data-start=\"2906\">\n\t<p data-end=\"3058\" data-start=\"2908\"><strong data-end=\"2919\" data-start=\"2908\">Futurum</strong> &auml;r alltid <strong data-end=\"2954\" data-start=\"2930\">grundform + &auml;ndelser</strong> (-&eacute;, -&aacute;s, -&aacute;, -emos, -&eacute;is, -&aacute;n) &mdash; &auml;ven f&ouml;r oregelbundna, men stammen kan &auml;ndras (tendr&eacute;, har&eacute;, podr&eacute;&hellip;).</p>\n\t</li>\n\t<li data-end=\"3191\" data-start=\"3059\">\n\t<p data-end=\"3191\" data-start=\"3061\"><strong data-end=\"3075\" data-start=\"3061\">Preteritum</strong> &auml;r d&auml;r flest oregelbundenheter dyker upp, ofta helt ny stam (<em data-end=\"3144\" data-start=\"3137\">tener</em> &rarr; <em data-end=\"3153\" data-start=\"3147\">tuv-</em>, <em data-end=\"3162\" data-start=\"3155\">hacer</em> &rarr; <em data-end=\"3171\" data-start=\"3165\">hic-</em>, <em data-end=\"3181\" data-start=\"3173\">ir/ser</em> &rarr; <em data-end=\"3189\" data-start=\"3184\">fu-</em>).</p>\n\t</li>\n\t<li data-end=\"3280\" data-start=\"3192\">\n\t<p data-end=\"3280\" data-start=\"3194\"><strong data-end=\"3205\" data-start=\"3194\">Presens</strong> oregelbundenhet syns ofta i <strong data-end=\"3245\" data-start=\"3234\">yo-form</strong> och stamv&auml;xling (e&rarr;ie, o&rarr;ue, e&rarr;i).</p>\n\t</li>\n</ul>\n\n<p>&nbsp;</p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Svenska mening</th>\n\t\t\t<th>Spanska &ouml;vers&auml;ttning</th>\n\t\t\t<th>Anv&auml;ndning/Betydelse</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>De m&aring;ste ha vilat</td>\n\t\t\t<td>Debieron de haber descansado</td>\n\t\t\t<td>Slutsats i d&aring;tid</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>De har varit tvungna att vila</td>\n\t\t\t<td>Han tenido que descansar</td>\n\t\t\t<td>Faktisk n&ouml;dv&auml;ndighet</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>De borde ha vilat</td>\n\t\t\t<td>Deber&iacute;an haber descansado</td>\n\t\t\t<td>&Aring;nger / borde ha gjort</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>De vilade</td>\n\t\t\t<td>Descansaron</td>\n\t\t\t<td>Enkel d&aring;tid / fakta</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>Tanto&nbsp;~= Mucho; Por tanto = &lt;d&auml;rf&ouml;r&gt;</p>\n\n<p>No se debe = man b&ouml;r inte</p>\n\n<p>---------------</p>\n\n<p><u><strong>Patrones de dise&ntilde;o</strong></u></p>\n\n<p><u><strong>Singleton:</strong></u></p>\n\n<p><u>Principo fundamental:</u>&nbsp;</p>\n\n<p>No lo hagas a menos que<br />\nsea necesario.&nbsp;<br />\nNo lo hagas si no hace falta.&nbsp;<br />\nNo lo hagas si no es necesario .</p>\n\n<p>Cu&aacute;l es el objetivo de eso?<br />\nPara qu&eacute; sirve eso?</p>\n\n<p>El objetivo es&nbsp;ahorrar recursos<br />\nevitando hacer algo<br />\nuna y otra vez&nbsp;[x2]<br />\ncuando no sea necesario</p>\n\n<p>Patron del singleton<br />\nConsiste en tener una&nbsp;<br />\n&uacute;nica instancia&nbsp;<br />\ndurante toda la aplicaci&oacute;n&nbsp;<br />\npara ahorrar recursos&nbsp;<br />\ncuando no es necesario&nbsp;<br />\ncrearla una y otra vez<br />\ncuando no es necesario</p>\n\n<p>para no gastar recursos&nbsp;<br />\ncreando lo misma&nbsp;<br />\nuna y otra vez&nbsp;<br />\ncuando no hace falta.</p>\n\n<p>Consiste en mantener<br />\nuna&nbsp;&uacute;nica instancia&nbsp;<br />\ncon el fin de optimiza&nbsp;<br />\ncon el fin de optimiza recursos&nbsp;<br />\ncuando no se requiere<br />\nrepetir&nbsp;su creaci&oacute;n. &nbsp;</p>\n\n<p>Se usa una sola instancia&nbsp;<br />\nde una clase&nbsp;<br />\npara que no haya que crearla&nbsp;<br />\ncada vez que se necesite&nbsp;<br />\nlo cual permite &nbsp;<br />\nlo cual permite &nbsp;<br />\nahorrar memoria&nbsp;<br />\ny mejorar el rendimiento.</p>\n\n<p><u><strong>Factor&iacute;a:</strong></u>&nbsp;el objetivo es esconder/ocultar la l&oacute;gica de la creaci&oacute;n.&nbsp;</p>\n\n<p>La meta es ocultar la l&oacute;gica <u>detr&aacute;s</u> de la&nbsp;creaci&oacute;n.&nbsp;</p>\n\n<p>Se busca esconder c&oacute;mo se cre&oacute;.</p>\n\n<p><u><strong>Composite:</strong></u>&nbsp;El objetivo es combinar muchas similares cositas <strong><u>para as&iacute;</u></strong>&nbsp;manejarlas mejor.&nbsp;</p>\n\n<p>La idea es juntar cositas parecidas para&nbsp;manejarlas mejor.&nbsp;</p>\n\n<p>Juntar <u>cosas parecidas</u> ayuda a organizarlas mejor.</p>\n\n<p>Mejor juntar lo parecido para manejarlo bien.</p>\n\n<p>---------------</p>\n\n<p>&iquest;Qu&eacute; necesito hacer para mejorar?<br />\nLo&nbsp;que&nbsp;t&uacute;&nbsp;tienes&nbsp;que&nbsp;hacer&nbsp;es&nbsp;leer mucho<br />\nLo que tienes que hacer es leer mucho.</p>\n\n<p>&iquest;Va a funcionar? [Kommer det att funka?]<br />\n&iquest;Funcionar&aacute;?<br />\n&iquest;Eso va a servir?</p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Spanska</th>\n\t\t\t<th>Svenska</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>Tal vez / Quiz&aacute;s</strong></td>\n\t\t\t<td>Kanske</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Es posible que&hellip;</strong></td>\n\t\t\t<td>Det &auml;r m&ouml;jligt att&hellip;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Puede ser</strong></td>\n\t\t\t<td>Det kan vara</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>A lo mejor&hellip;</strong></td>\n\t\t\t<td>Kanske&hellip;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Probablemente&hellip;</strong></td>\n\t\t\t<td>Troligen&hellip;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>Seguramente&hellip;</strong></td>\n\t\t\t<td>F&ouml;rmodligen&hellip;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>podr&iacute;a ser que ...</strong></td>\n\t\t\t<td>Det skulle kunna vara att ..</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Spansk fras</th>\n\t\t\t<th>Stilniv&aring;</th>\n\t\t\t<th>Betydelse / Nyans</th>\n\t\t\t<th>Exempel</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>lo que hace que</strong></td>\n\t\t\t<td>Neutral / standard</td>\n\t\t\t<td>Direkt motsvarighet, allm&auml;nt bruk</td>\n\t\t\t<td><em>Trabaja mucho, <strong>lo que hace que</strong> casi nunca est&eacute; en casa.</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>lo que provoca que</strong></td>\n\t\t\t<td>Formell / teknisk</td>\n\t\t\t<td>Betonar orsak och effekt</td>\n\t\t\t<td><em>Ha llovido toda la semana, <strong>lo que provoca que</strong> el partido se cancele.</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>lo que lleva a que</strong></td>\n\t\t\t<td>Formell / litter&auml;r</td>\n\t\t\t<td>Leder till n&aring;got (orsak&ndash;verkan)</td>\n\t\t\t<td><em>Es muy perfeccionista, <strong>lo que lleva a que</strong> tarde en terminar sus proyectos.</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>por lo que</strong></td>\n\t\t\t<td>Vardaglig / koncis</td>\n\t\t\t<td>&quot;Och d&auml;rf&ouml;r&quot; i kortform</td>\n\t\t\t<td><em>Est&aacute; muy cansado, <strong>por lo que</strong> se fue a dormir temprano.</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>y por ello</strong></td>\n\t\t\t<td>Litter&auml;r / poetisk</td>\n\t\t\t<td>Elegant, mer h&ouml;gtidligt</td>\n\t\t\t<td><em>No encontr&oacute; respuestas, <strong>y por ello</strong> sigui&oacute; buscando.</em></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>y as&iacute;</strong></td>\n\t\t\t<td>Poetisk / ber&auml;ttande</td>\n\t\t\t<td>&quot;Och s&aring;&quot; som resultat</td>\n\t\t\t<td><em>No quedaban m&aacute;s caminos, <strong>y as&iacute;</strong> se detuvo.</em></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p><strong data-end=\"136\" data-start=\"118\">al + infinitiv</strong> &rarr; &ldquo;n&auml;r&rdquo; eller &ldquo;genom att&rdquo;.&nbsp;Al entrar en la habitaci&oacute;n, me mir&oacute;.&nbsp;Al estudiar mucho, mejor&oacute; sus notas.</p>\n\n<p><strong data-end=\"471\" data-start=\"465\">al</strong> som sammandragning av <strong data-end=\"504\" data-start=\"494\">a + el</strong> (plats, riktning, tid).&nbsp;Voy a el parque. Llegaremos al mediod&iacute;a.</p>\n\n<p><strong data-end=\"955\" data-start=\"949\">al</strong> i fasta uttryck:&nbsp;<strong data-end=\"986\" data-start=\"976\">al d&iacute;a</strong> &rarr; <em data-end=\"1009\" data-start=\"989\">per dag / om dagen,&nbsp;</em><strong data-end=\"1030\" data-start=\"1014\">al principio</strong> &rarr; <em data-end=\"1043\" data-start=\"1033\">i b&ouml;rjan,&nbsp;</em><strong data-end=\"1060\" data-start=\"1048\">al final</strong> &rarr; <em data-end=\"1073\" data-start=\"1063\">i slutet</em></p>\n\n<p>Vamos a ver - vi f&aring;r se, l&aring;t oss se</p>\n\n<p data-end=\"108\" data-start=\"76\"><strong data-end=\"95\" data-start=\"76\">&iexcl;Absolutamente!</strong> &ndash; Absolut!</p>\n\n<p data-end=\"146\" data-start=\"112\"><strong data-end=\"130\" data-start=\"112\">&iexcl;Claro que s&iacute;!</strong> &ndash; Sj&auml;lvklart!</p>\n\n<p data-end=\"198\" data-start=\"150\"><strong data-end=\"168\" data-start=\"150\">&iexcl;Por supuesto!</strong> &ndash; Sj&auml;lvklart / Naturligtvis.&nbsp; <strong><span style=\"color:#c0392b;\">Presupuesto</span></strong> = budget</p>\n\n<p data-end=\"245\" data-start=\"202\"><strong data-end=\"219\" data-start=\"202\">&iexcl;Desde luego!</strong> &ndash; Givetvis / Sj&auml;lvklart</p>\n\n<p data-end=\"279\" data-start=\"249\"><strong data-end=\"263\" data-start=\"249\">&iexcl;Sin duda!</strong> &ndash; Utan tvekan</p>\n\n<p data-end=\"279\" data-start=\"249\">entonces - s&aring;, allts&aring;, d&aring;</p>\n\n<p data-end=\"279\" data-start=\"249\">En cuanto a&nbsp; (&quot;vad g&auml;ller ..&quot;). Unos cuanto =&nbsp;n&aring;gra stycken, ett par, n&aring;gra f&aring;;&nbsp;Cu&aacute;nto / cu&aacute;ntos / cu&aacute;nta / cu&aacute;ntas&quot;= hur mycket/m&aring;nga?</p>\n\n<p data-end=\"279\" data-start=\"249\">(La cosa) Es que = &quot;grejen &auml;r att&quot;</p>\n\n<p data-end=\"279\" data-start=\"249\">De hecho = &quot;Faktisk / I sj&auml;lva verket&quot;</p>\n\n<p data-end=\"279\" data-start=\"249\">&nbsp;</p>\n\n<p data-end=\"279\" data-start=\"249\">Y al final, fue as&iacute;. (&quot;Och till slut blev det s&aring;&quot;)</p>\n\n<p data-end=\"279\" data-start=\"249\">Ahora solamento <strong>hago</strong> ... [Nu, g&ouml;r jag bara ...]</p>\n\n<p data-end=\"279\" data-start=\"249\">Y porqu&eacute; <strong>haces</strong> eso? [Och, varf&ouml;r g&ouml;r du s&aring;/det]</p>\n\n<p data-end=\"279\" data-start=\"249\">todo lo que <strong>hacemos</strong> [allt vi g&ouml;r]</p>\n\n<p data-end=\"279\" data-start=\"249\">No <strong>hice</strong> caso [Jag tog ingen notis/struntade i]</p>\n\n<p data-end=\"279\" data-start=\"249\">Yo lo que <strong>hice</strong> fue que [Det som jag gjorde var att ..]</p>\n\n<p data-end=\"279\" data-start=\"249\">Lo <strong>hice</strong> porque es lo &uacute;nico que pude hacer. (Jag gjorde eftersom det var det enda jag kunde g&ouml;ra)</p>\n\n<p data-end=\"279\" data-start=\"249\">No reneg&oacute; nada cuando le <strong>hiciste</strong> as&iacute;. [Hon/han klagade/gn&auml;llde/protesterade inte n&auml;r du gjorde s&aring;nt]&nbsp;</p>\n\n<p data-end=\"279\" data-start=\"249\">Parece que [verkar som/att]</p>\n\n<p data-end=\"279\" data-start=\"249\">Se <strong>hizo</strong> una encuesta [en unders&ouml;kning gjordes]</p>\n\n<p data-end=\"279\" data-start=\"249\">se pregunt&oacute; a la gente qu&eacute; piensa sobre el cambia clim&aacute;tico [<em data-end=\"634\" data-start=\"574\">Man fr&aring;gade m&auml;nniskor vad de tycker om klimatf&ouml;r&auml;ndringar.</em>]</p>\n\n<p data-end=\"279\" data-start=\"249\">cosito que <strong>hicieron</strong> en su d&iacute;a [saker som de gjorde i sin tid]</p>\n\n<p data-end=\"279\" data-start=\"249\">Estas personas en su momento [p&aring; sin tid/d&aring;/vid den tiden]&nbsp;<u>me <strong>hicieron</strong> feliz</u> [gjorde mig lycklig] pero ya no [men inte l&auml;ngre].&nbsp;</p>\n\n<p data-end=\"279\" data-start=\"249\">No lo <strong>hago</strong>. No lo <strong>har&eacute;</strong>.</p>\n\n<p data-end=\"279\" data-start=\"249\">Mi filosof&iacute;a es <u>haz</u> lo que te d&eacute; le gana este mundo <u>mientras</u> no <strong><u>hagas</u></strong> da&ntilde;o a otros. [dar la gana = att ge lust; te d&eacute; la garna = som du f&aring;r lust till, som du vill, mientras=s&aring; l&auml;nge]</p>\n\n<p data-end=\"279\" data-start=\"249\">Voy a <strong>hacer</strong> <u>te d&eacute; la gana</u>. [Jag kommer g&ouml;ra precis vad jag vill]</p>\n\n<p data-end=\"279\" data-start=\"249\">Lo que quieras = det du vill</p>\n\n<p data-end=\"279\" data-start=\"249\"><strong>Haz</strong> lo que te d&eacute; la gana pero <u>luego</u> [sen] <u>no te quejes</u> [klaga&nbsp;&nbsp;inte].</p>\n\n<p data-end=\"279\" data-start=\"249\">&nbsp;</p>\n\n<p data-end=\"279\" data-start=\"249\">---------------</p>\n\n<p data-end=\"279\" data-start=\"249\">&nbsp;</p>\n\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Svenska</th>\n\t\t\t<th>Spanska</th>\n\t\t\t<th>Svenska</th>\n\t\t\t<th>Spanska</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>1</td>\n\t\t\t<td>uno</td>\n\t\t\t<td>26</td>\n\t\t\t<td>veintis&eacute;is</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>2</td>\n\t\t\t<td>dos</td>\n\t\t\t<td>27</td>\n\t\t\t<td>veintisiete</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>3</td>\n\t\t\t<td>tres</td>\n\t\t\t<td>28</td>\n\t\t\t<td>veintiocho</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>4</td>\n\t\t\t<td>cuatro</td>\n\t\t\t<td>29</td>\n\t\t\t<td>veintinueve</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>5</td>\n\t\t\t<td>cinco</td>\n\t\t\t<td>30</td>\n\t\t\t<td>treinta</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>6</td>\n\t\t\t<td>seis</td>\n\t\t\t<td>31</td>\n\t\t\t<td>treinta y uno</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>7</td>\n\t\t\t<td>siete</td>\n\t\t\t<td>32</td>\n\t\t\t<td>treinta y dos</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>8</td>\n\t\t\t<td>ocho</td>\n\t\t\t<td>40</td>\n\t\t\t<td>cuarenta</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>9</td>\n\t\t\t<td>nueve</td>\n\t\t\t<td>41</td>\n\t\t\t<